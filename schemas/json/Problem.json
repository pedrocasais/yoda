{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/components/schemas/ProblemFields"
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "open_at": {
          "type": "string",
          "format": "date-time",
          "description": "Optional date/time from which the problem is open."
        },
        "close_at": {
          "type": "string",
          "format": "date-time",
          "description": "Optional date/time after which the problem is closed."
        },
        "is_force_closed": {
          "type": "boolean",
          "description": "True when the problem has been manually stopped by an admin."
        },
        "object_artifacts": {
          "$ref": "#/components/schemas/ObjectArtifacts"
        }
      },
      "required": [
        "code",
        "title",
        "time_limit_ms",
        "memory_limit_mb",
        "description",
        "input_spec",
        "output_spec",
        "languages"
      ]
    }
  ]
}