{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entrypoint": {
      "type": "string",
      "description": "Oracle checker entrypoint filename"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
