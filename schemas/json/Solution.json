{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "problem_id": {
      "type": "integer"
    },
    "language": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "The name of the source file"
          },
          "content": {
            "type": "string",
            "description": "The content of the source file"
          }
        },
        "required": [
          "filename",
          "content"
        ]
      }
    }
  },
  "required": [
    "problem_id",
    "language",
    "source_artifacts"
  ]
}