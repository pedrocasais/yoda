  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "user",
          "judge",
          "admin"
        ]
      },
      "UserGroup": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "groups": {
            "$ref": "#/components/schemas/UserGroup"
          },
          "created_at": {
            "type": "string"
          },
          "last_seen_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "groups",
          "created_at"
        ]
      },
